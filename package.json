{
  "name": "mcp-token-saver",
  "version": "0.1.0",
  "description": "Local MCP server that estimates tokens, optimizes context, and tracks budget for AI coding assistants (Claude, GPT-4o).",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "tokens",
    "tokenizer",
    "context",
    "cost",
    "budget",
    "anthropic",
    "openai"
  ],
  "bin": {
    "mcp-token-saver": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "src/prompts",
    "README.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspector": "npx -y @modelcontextprotocol/inspector node dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@babel/parser": "^7.25.0",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "proper-lockfile": "^4.1.2",
    "tiktoken": "^1.0.17",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
